#
# Regenerates <build>/generated/common/version_info.hpp with the current
# `git describe --always --dirty` string.
#
# Run via `add_custom_target(... ALL COMMAND ${CMAKE_COMMAND} -P
# cmake/GenerateVersion.cmake ...)` (see CMakeLists.txt) so this re-executes on
# EVERY `cmake --build` invocation, not only at configure time -- otherwise the
# embedded SHA would go stale across commits made without touching
# CMakeLists.txt (a pure configure-time execute_process() only runs when
# CMake itself re-configures). The output file is only rewritten when its
# content actually changes, so an unchanged SHA does not force a rebuild of
# every translation unit that includes this header.
#
# Works from a source tarball / exported archive with no `.git` at all (falls
# back to "unknown"), and from a git worktree where `.git` is a plain text
# file pointing at the main repo's gitdir (not a directory) -- `git` itself
# resolves that; we only need to gate on SRC_DIR/.git existing (EXISTS is true
# for both a `.git` directory and a `.git` file).

if(NOT DEFINED SRC_DIR OR NOT DEFINED OUT_FILE)
  message(FATAL_ERROR "GenerateVersion.cmake: SRC_DIR and OUT_FILE are required")
endif()

set(_git_sha "unknown")

find_package(Git QUIET)
if(GIT_EXECUTABLE AND EXISTS "${SRC_DIR}/.git")
  execute_process(
    COMMAND "${GIT_EXECUTABLE}" describe --always --dirty
    WORKING_DIRECTORY "${SRC_DIR}"
    RESULT_VARIABLE _git_rc
    OUTPUT_VARIABLE _git_out
    ERROR_QUIET
    OUTPUT_STRIP_TRAILING_WHITESPACE
  )
  if(_git_rc EQUAL 0 AND NOT _git_out STREQUAL "")
    set(_git_sha "${_git_out}")
  endif()
endif()

set(_content "// Generated by cmake/GenerateVersion.cmake -- do not edit.
// Re-generated on every build; see that script for why.
#pragma once

namespace acceptance {

inline constexpr const char* kGitSha = \"${_git_sha}\";

}  // namespace acceptance
")

set(_write_new TRUE)
if(EXISTS "${OUT_FILE}")
  file(READ "${OUT_FILE}" _existing)
  if(_existing STREQUAL _content)
    set(_write_new FALSE)
  endif()
endif()

if(_write_new)
  file(WRITE "${OUT_FILE}" "${_content}")
endif()
